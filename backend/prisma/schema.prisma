generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  username  String?
  email     String    @unique
  password  String?
  googleId  String?   @unique
  createdAt DateTime  @default(now())

  bookings  Booking[]
}

model Homestay {
  id          Int       @id @default(autoincrement())
  name        String
  location    String
  price       Int
  rating      Float
  description String?
  image       String?
  bookings    Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())

  // Booking Details
  checkIn   DateTime
  checkOut  DateTime
  guests    Int
  createdAt DateTime @default(now())

  // User
  userId    Int
  user      User @relation(fields: [userId], references: [id])

  // Optional Local Homestay
  homestayId Int?
  homestay   Homestay? @relation(fields: [homestayId], references: [id])

  // Geoapify Data
  homestayName String
  address      String

  latitude  Float
  longitude Float

  estimatedPrice Int

  category String?

  image String?

  status String @default("Confirmed")
}